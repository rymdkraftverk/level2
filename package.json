{
  "name": "l2",
  "version": "1.0.0",
  "description": "Game helpers for pixi: an update scheduler, a display-object registry, textures, resizing",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sound": {
      "types": "./dist/sound.d.ts",
      "default": "./dist/sound.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "qa": "npm test && npm run lint && npm run typecheck"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/rymdkraftverk/level2.git"
  },
  "author": "rymdkraftverk",
  "license": "ISC",
  "peerDependencies": {
    "howler": "^2.2.4",
    "pixi.js": "^8.20.1"
  },
  "peerDependenciesMeta": {
    "howler": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/howler": "^2.2.12",
    "@types/node": "^22.20.2",
    "eslint": "^9.39.0",
    "eslint-config-airbnb-extended": "^3.2.0",
    "globals": "^16.5.0",
    "howler": "^2.2.4",
    "pixi.js": "^8.20.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
