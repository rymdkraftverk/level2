{
  "name": "l2",
  "version": "1.0.0",
  "description": "Game update scheduler: run behaviors on a fixed number of ticks",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
